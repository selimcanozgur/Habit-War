{
  "name": "@habitwar/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "worker": "tsx --env-file-if-exists=.env src/jobs/worker.ts",
    "start:worker": "node dist/jobs/worker.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@habitwar/domain": "*",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.3.1",
    "bullmq": "^6.3.8",
    "expo-server-sdk": "^7.2.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "prisma": "^6.3.1",
    "tsx": "^4.23.13"
  }
}
