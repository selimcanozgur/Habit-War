# Copy to .env and fill in. Only DATABASE_URL is needed for local work.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://habitwar:habitwar_dev@localhost:5432/habitwar
REDIS_URL=redis://localhost:6379

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Authentication ---------------------------------------------------------
# dev   — trusts an x-dev-user-id header. Local work only; refused in production.
# token — this product's own sign-in. What runs in production.
AUTH_MODE=dev

# Signs the access tokens. Required when AUTH_MODE=token, 32 characters minimum.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs every live user out, which is the intended behaviour if it leaks.
AUTH_JWT_SECRET=

# Whether a new password account must confirm its address before signing in.
# Off locally because there is no mail server; required true in production,
# since otherwise anyone can register under an address they do not own.
REQUIRE_EMAIL_VERIFICATION=false

# --- Social sign-in ---------------------------------------------------------
# Comma-separated: one Google project issues a different client id per platform
# (iOS, Android, web), and a token minted for any of them is legitimately ours.
# Leave empty and the Google route is not registered at all.
GOOGLE_CLIENT_IDS=

# Apple Services ID / bundle ids, comma-separated. Same reasoning.
APPLE_CLIENT_IDS=

# --- Mail -------------------------------------------------------------------
# Without a key, verification and reset tokens are written to the API log instead
# of being sent — which is how local work gets the link with no mail account.
# Required in production: password reset depends on outbound mail.
RESEND_API_KEY=
MAIL_FROM=Habit War <onboarding@resend.dev>

# Where the links in those mails point.
APP_URL=http://localhost:8081

# --- Browser clients --------------------------------------------------------
# Comma-separated origins allowed to call this API from a browser.
# Empty in development, where any localhost/LAN origin is accepted instead.
CORS_ORIGINS=

# --- Book search --------------------------------------------------------------
# Optional. Google Books answers without a key at low volume; a key raises the quota.
GOOGLE_BOOKS_API_KEY=
