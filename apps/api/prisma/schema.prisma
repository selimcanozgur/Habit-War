// Habit War — reading schema.
//
// The product is a reading app (docs/product-v2.md): a reader adds books, logs the
// pages they read, and grows a character from consistency. Every table here is
// reachable from a route; nothing is modelled ahead of need.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  /// Argon2id hash of the password, for accounts that have one.
  ///
  /// Null for an account created through Google or Apple: that user has no password
  /// here, and storing an empty string instead would make "has a password" a check
  /// on falsiness rather than on nullness — the kind of distinction that eventually
  /// lets a blank password authenticate.
  passwordHash String?

  /// Set once the user proves they control the address. Sign-in is refused until
  /// then for password accounts; a provider account arrives already verified,
  /// because Google and Apple have done it.
  emailVerifiedAt DateTime?

  username    String  @unique
  displayName String
  email       String  @unique
  avatarUrl   String?

  /// IANA timezone. Owns the day boundary for streaks, the daily goal and reminders.
  timezone String @default("Europe/Istanbul")

  /// App language. Also picks the language of reminder pushes, which the server
  /// writes without a client in the loop.
  locale Locale @default(TR)

  /// When the user finished the first-run flow. Null sends the app to that flow on
  /// the next launch.
  onboardedAt DateTime?

  // --- Reading habit ---------------------------------------------------------
  /// Pages per day. One of DAILY_GOAL_OPTIONS in @habitwar/domain.
  dailyGoal    Int      @default(10)
  /// When the current goal was chosen. The smaller-goal suggestion only judges a
  /// goal that has had a full review window to work.
  goalSetAt    DateTime @default(now())
  /// Local wall-clock time for the daily reminder, "HH:MM". Null means no reminder.
  reminderTime String?  @db.VarChar(5)
  /// Local day (YYYY-MM-DD) the last reminder went out. Makes the reminder job
  /// idempotent: at most one per local day, however often it runs.
  lastRemindedDate String? @db.VarChar(10)

  // --- Progression -------------------------------------------------------------
  /// Total XP. A cache of XpLedger, which remains the source of truth.
  xp    Int @default(0)
  /// Denormalised from xp for cheap reads.
  level Int @default(1)

  /// Reading streak in days, forgiving STREAK_GRACE_DAYS missed days.
  currentStreak Int     @default(0)
  longestStreak Int     @default(0)
  /// Local day of the last reading log. A date key rather than a timestamp so streak
  /// arithmetic never has to re-derive "which day was that for this user".
  lastReadDate  String? @db.VarChar(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Soft delete. Erasure takes effect for the user immediately; the hard delete runs
  /// as a scheduled job after the retention window.
  deletedAt DateTime?

  books       Book[]
  readingLogs ReadingLog[]
  xpLedger    XpLedger[]
  pushTokens  PushToken[]

  authIdentities AuthIdentity[]
  authSessions   AuthSession[]
  authTokens     AuthToken[]

  @@index([deletedAt])
  /// The reminder job's candidate scan.
  @@index([reminderTime])
}

// ---------------------------------------------------------------------------
// Book
// ---------------------------------------------------------------------------

/// A book the user is reading — and, in the game, an enemy whose hit points are its
/// pages.
model Book {
  id     String @id @default(cuid())
  userId String

  title     String  @db.VarChar(200)
  author    String? @db.VarChar(200)
  pageCount Int

  /// Pages logged against this book. Never exceeds pageCount.
  pagesRead Int @default(0)

  status     BookStatus @default(READING)
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs ReadingLog[]

  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Reading log
// ---------------------------------------------------------------------------

/// One "I read N pages" entry.
model ReadingLog {
  id     String @id @default(cuid())
  userId String
  bookId String

  /// Client-generated idempotency key. Without it a retried request logs the pages,
  /// and pays the XP, twice.
  clientRequestId String @unique

  /// Pages recorded, after clamping to what was left of the book.
  pages Int

  /// The user's local day (YYYY-MM-DD) when the log was written.
  dateKey String @db.VarChar(10)

  xpAwarded Int  @default(0)
  /// The full ReadingLogScore, so any award can be re-derived and explained.
  score     Json

  createdAt DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  xpLedger XpLedger[]

  /// "Pages read today", the last-30-days figure and the goal review.
  @@index([userId, dateKey])
  @@index([bookId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// XP ledger
// ---------------------------------------------------------------------------

/// Append-only record of every XP movement. User.xp is a cache of this table, so a
/// wrong award can always be found, explained and reversed.
model XpLedger {
  id     String @id @default(cuid())
  userId String

  /// Signed: positive for awards, negative for corrections.
  amount Int
  reason XpReason

  readingLogId String?

  /// Human-readable justification, shown to the user on request.
  note String?

  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SetNull: deleting a book takes its logs, but the XP history stays explainable.
  readingLog ReadingLog? @relation(fields: [readingLogId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([readingLogId])
}

// ---------------------------------------------------------------------------
// Push tokens
// ---------------------------------------------------------------------------

/// Expo push token, one row per device. Used only for the daily reading reminder.
model PushToken {
  id     String @id @default(cuid())
  userId String

  /// ExponentPushToken[...]. Unique globally: a device that signs into a second
  /// account must MOVE the token, not duplicate it, or the previous owner keeps
  /// receiving the new owner's reminders.
  token String @unique

  platform DevicePlatform

  /// Set when Expo reports the token as DeviceNotRegistered.
  disabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, disabledAt])
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

/// A linked Google or Apple account.
///
/// Separate from User rather than a pair of columns, because one person may hold
/// both — and because a password account and a Google account for the same address
/// are the same person, not two. Sign-in links the provider to the existing row by
/// verified email instead of creating a second account.
model AuthIdentity {
  id     String @id @default(cuid())
  userId String

  provider AuthProvider

  /// The provider's own subject id (`sub`). Stable across email changes there,
  /// which is why the link is keyed on it and not on the address.
  providerAccountId String

  /// The address the provider asserted at link time. Kept for support questions —
  /// never used to authenticate, since User.email is this product's own truth.
  email String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One link per provider per account, and one account per provider subject.
  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

/// A refresh token, one row per signed-in device.
///
/// Rows rather than stateless JWTs because sign-out has to actually revoke: a
/// stateless refresh token stays valid until it expires, so "log out my stolen
/// phone" would be a lie. Only the hash is stored — a database leak must not hand
/// the attacker working tokens.
model AuthSession {
  id     String @id @default(cuid())
  userId String

  /// SHA-256 of the refresh token.
  tokenHash String @unique

  /// What the user sees in a device list. Free text from the client, so it is
  /// display-only and never trusted for a decision.
  userAgent String? @db.VarChar(200)
  ipAddress String? @db.VarChar(45)

  expiresAt DateTime
  createdAt DateTime @default(now())

  /// Set when the token is rotated or revoked; a used token is kept rather than
  /// deleted so that replaying it can be detected.
  revokedAt DateTime?

  /// The session this one was rotated into, for walking a reuse chain.
  replacedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A single-use token for verifying an email or resetting a password.
///
/// Hashed like a refresh token and for the same reason: whoever reads this table
/// must not be able to take over an account with what they find. `consumedAt`
/// enforces single use, which is what stops a reset link forwarded in an email
/// thread from working a second time.
model AuthToken {
  id     String @id @default(cuid())
  userId String

  kind      AuthTokenKind
  tokenHash String        @unique

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Locale {
  TR
  EN
}

enum BookStatus {
  READING
  FINISHED
}

enum XpReason {
  READING_LOG
  MANUAL_ADJUSTMENT
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum AuthProvider {
  GOOGLE
  APPLE
}

enum AuthTokenKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
