DATABASE_URL="postgresql://habitwar:habitwar_dev@localhost:5432/habitwar?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000
NODE_ENV=development

# auth: "clerk" (varsayilan) veya "dev". "dev" x-dev-user-id header ina guvenir
# ve production ta bilerek reddedilir.
AUTH_MODE=dev
# AUTH_MODE=clerk icin zorunlu:
# CLERK_SECRET_KEY=sk_test_...
# Webhook rotasi yalnizca bu deger varsa kaydedilir:
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
